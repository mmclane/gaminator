DISCORD_TOKEN=
# One server ID, or several separated by commas. Leave empty for global sync (slow to update).
GUILD_ID=
LOG_LEVEL=INFO
# Where the SQLite database lives. The default matches the Docker volume.
# DATABASE_PATH=/data/gaminator.db

# --- Assassin ---
# Optional: path to a YAML file with a `words:` list to replace the built-in poison words.
# POISON_WORDS_FILE=poison_words.yaml
# How often (minutes) the bot checks for inactive players and overdue bounties. Default 10.
# SWEEP_MINUTES=10

# --- Imposter ---
# Optional: path to a YAML file with a `prompts:` list to replace the built-in prompts.
# IMPOSTER_PROMPTS_FILE=prompts.yaml

# --- Testing ---
# Lower every game's minimum player count so you can test with fewer people. Remove for real play.
# MIN_PLAYERS=2
