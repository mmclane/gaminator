DISCORD_TOKEN=
# One server ID, or several separated by commas. Leave empty for global sync (slow to update).
GUILD_ID=
LOG_LEVEL=INFO
# Where the SQLite database lives. The default matches the Docker volume.
# DATABASE_PATH=/data/gaminator.db

# --- Assassin ---
# Optional: path to a YAML file with a `words:` list to replace the built-in poison words.
# POISON_WORDS_FILE=poison_words.yaml
# How often (minutes) the bot checks for inactive players and overdue bounties. Default 10.
# SWEEP_MINUTES=10

# --- Imposter ---
# Optional: path to a YAML file with a `prompts:` list to replace the built-in prompts.
# IMPOSTER_PROMPTS_FILE=prompts.yaml

# --- Most Likely To ---
# Optional: path to a YAML file with a `prompts:` list to replace the built-in prompts.
# MOSTLIKELY_PROMPTS_FILE=mostlikely_prompts.yaml
# Seconds a prompt stays open before it closes by itself. Default 120, minimum 10.
# MOSTLIKELY_VOTE_SECONDS=120

# --- Fifty-Fifty ---
# Optional: path to a YAML file with a `topics:` list of short topic ideas (plain text, up to 40
# characters each) to replace the built-in ones. Players write both options themselves.
# FIFTYFIFTY_PROMPTS_FILE=fiftyfifty_prompts.yaml
# Seconds players get to write their two options each round. Default 120, minimum 30.
# FIFTYFIFTY_WRITE_SECONDS=120
# Seconds each question stays open for votes and guesses. Default 60, minimum 10.
# FIFTYFIFTY_VOTE_SECONDS=60

# --- Spectrum ---
# Optional: path to a YAML file with a `scales:` list of {left, right} ends to replace the built-in deck.
# SPECTRUM_SCALES_FILE=spectrum_scales.yaml
# Seconds the clue giver gets to write a clue. Default 120, minimum 30.
# SPECTRUM_CLUE_SECONDS=120
# Seconds everyone else gets to guess once the clue is in. Default 120, minimum 20.
# SPECTRUM_GUESS_SECONDS=120

# --- Headlines ---
# Optional: path to a YAML file with a `questions:` list (plain text, up to 100 characters each) to replace the built-in questions.
# HEADLINES_QUESTIONS_FILE=headlines_questions.yaml
# Seconds players get to answer their question. Default 90, minimum 30.
# HEADLINES_ANSWER_SECONDS=90
# Seconds players get to write their headline. Default 120, minimum 30.
# HEADLINES_WRITE_SECONDS=120
# Seconds the vote stays open. Default 60, minimum 20.
# HEADLINES_VOTE_SECONDS=60

# --- Testing ---
# Lower every game's minimum player count so you can test with fewer people. Remove for real play.
# MIN_PLAYERS=2
